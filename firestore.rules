rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin(){ return request.auth != null && request.auth.token.email_verified == true && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    match /admins/{id} { allow read: if request.auth != null && request.auth.uid == id; allow write: if false; }
    match /config/{id} { allow read: if true; allow write: if isAdmin(); }
    match /stock/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /users/{id} {
      allow read: if isAdmin() || (request.auth != null && request.auth.uid == id);
      allow create: if request.auth != null && request.auth.uid == id && request.resource.data.role == 'cliente';
      allow update, delete: if false;
    }
    match /reviews/{rid} {
      allow read: if resource.data.status == 'aprobada' || isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && rid == request.auth.uid + '_' + string(request.resource.data.pid)
        && request.resource.data.status == 'pendiente'
        && request.resource.data.stars is int && request.resource.data.stars >= 1 && request.resource.data.stars <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 400;
      allow update, delete: if isAdmin();
    }
    match /audit/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.who == request.auth.token.email;
      allow update, delete: if false;
    }
    match /newsletter/{id} {
      allow read: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly(['email','ts','v'])
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.email.matches('.+@.+[.].+') && id == request.resource.data.email.lower();
      allow update, delete: if false;
    }
    match /giftcards/{code} {
      allow read: if isAdmin();
      allow create: if request.auth != null && request.auth.token.email != null
        && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pendiente'
        && request.resource.data.a is int && request.resource.data.a >= 10000 && request.resource.data.a <= 500000
        && request.resource.data.to is string && request.resource.data.to.size() <= 120
        && request.resource.data.n is string && request.resource.data.n.size() <= 40
        && request.resource.data.m is string && request.resource.data.m.size() <= 200;
      allow update: if isAdmin();
    }
    match /mail/{id} { allow read, write: if isAdmin(); }
    match /orders/{code} {
      allow get: if true;
      allow list: if isAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow create: if request.resource.data.status == 'pendiente' && request.resource.data.ref == ''
        && !('proof' in request.resource.data) && !('stocked' in request.resource.data)
        && (request.resource.data.uid == '' || (request.auth != null && request.resource.data.uid == request.auth.uid));
      allow update, delete: if isAdmin();
    }
  }
}
